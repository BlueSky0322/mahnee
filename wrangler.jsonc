{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahnee",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Only the workers.dev address, which Access covers: no per-version preview addresses
  "preview_urls": false,
  // Runs the Worker near the D1 database when that is faster than near the visitor
  "placement": { "mode": "smart" },
  // Cloudflare Access app protecting this Worker ("mahnee - Cloudflare Workers", on its
  // workers.dev address). The API refuses every request unless both are set. Locally,
  // .dev.vars blanks them and sets DEV_USER_EMAIL.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ryanng-0611.cloudflareaccess.com",
    "ACCESS_AUD": "18cc5a8ad6ad6b831b40ab4a17ab3a1e152251f8a556ce570ff110edcc59aa26",
    // Reminders (worker/push/): the public key devices subscribe with (an uncompressed
    // P-256 point, base64url); its private key is the VAPID_PRIVATE_KEY secret (a JWK).
    // Without both, no reminder is sent.
    "VAPID_PUBLIC_KEY": "BLUdmedG6uf8THqDAtX3N3KvnnUsGuWw4ZMXKq9QypnMgPiC652_FF5R5FMnUUv7SAa8VEh9znXf9S8hPU-wbak",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, which must never get the app's page
    "run_worker_first": ["/api/*"],
  },
  // The nightly job that adds scheduled entries on their day (worker/ledger/post-scheduled.ts)
  // runs every 15 minutes, so each person's midnight is reached within a quarter of an hour
  // wherever they are; reminders share it (worker/push/reminders.ts). A deploy sets it up.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Logs and traces in the dashboard, for a tenth of requests
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // Caps how many changes each account can make a minute (reads are not counted). It
  // counts per Cloudflare location, so it is a budget, not an exact global quota.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  // Converting every amount after the home currency changes, a step at a time
  // (worker/currency/convert-queue.ts). Both queues must exist before a deploy with this
  // config (a deploy doesn't make them): mahnee-reconvert and mahnee-reconvert-dlq.
  "queues": {
    "producers": [{ "binding": "CONVERT_QUEUE", "queue": "mahnee-reconvert" }],
    "consumers": [
      {
        "queue": "mahnee-reconvert",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "dead_letter_queue": "mahnee-reconvert-dlq",
      },
      { "queue": "mahnee-reconvert-dlq", "max_batch_size": 10, "max_retries": 0 },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahnee-db",
      "database_id": "8c1cd6a9-1db0-4a18-aabb-31339f5e7757",
      "migrations_dir": "migrations",
    },
  ],
}
