{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahnee-mcp",
  "main": "worker/mcp/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "vars": {
    "MAHNEE_MCP_MANAGED": "BlueSky0322/mahnee:mcp-v1",
    "ACCESS_TEAM_DOMAIN": "ryanng-0611.cloudflareaccess.com",
    "MAHNEE_MCP_NATIVE_OAUTH": "v1"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true, "logs": { "invocation_logs": false } },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "REGISTER_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "REGISTER_ALL_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahnee-db",
      "database_id": "8c1cd6a9-1db0-4a18-aabb-31339f5e7757",
      "migrations_dir": "migrations"
    }
  ]
}
